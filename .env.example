# Copia este archivo como .env (nunca subas .env al repositorio).

# Modelo local para NL2SQL (opcional: sin Ollama el agente usa el motor de reglas)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_S=120

# Secreto para firmar los tokens de la API REST (genera uno largo y aleatorio)
API_SECRET=cambia-este-valor-por-uno-aleatorio
